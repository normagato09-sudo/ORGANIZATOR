# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" (con secretos reales) a Git.

# --- Almacenamiento (Redis) ---
# URL de conexión a la base de datos Redis (Upstash, Redis Cloud, etc.).
# Si no se define, el servidor de desarrollo usa un almacenamiento local
# en el fichero .local-kv.json (solo válido para desarrollo, no para producción).
REDIS_URL=redis://usuario:contraseña-de-ejemplo@host-redis-de-ejemplo:6379

# --- Notificaciones push (Web Push / VAPID) ---
# Par de claves VAPID para enviar notificaciones push al navegador.
# Genéralas con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BExampleVapidPublicKeyPlaceholder1234567890
VAPID_PRIVATE_KEY=ExampleVapidPrivateKeyPlaceholder1234567890

# Identidad del remitente exigida por el estándar Web Push (mailto: o https:)
VAPID_SUBJECT=mailto:notificaciones@ejemplo.com

# --- Tarea programada (cron) ---
# Secreto que debe enviarse como "Authorization: Bearer <CRON_SECRET>"
# para poder llamar manualmente a /api/cron/check-notifications.
CRON_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Sesiones de usuario ---
# Secreto usado para firmar las cookies de sesión. Debe ser largo,
# aleatorio y distinto en cada entorno (desarrollo/producción).
SESSION_SECRET=cambia-esto-por-otro-secreto-largo-y-aleatorio

# --- Entorno de ejecución ---
# "development" en local, "production" en el servidor real.
# En producción activa el flag "Secure" de las cookies, entre otras cosas.
NODE_ENV=development
