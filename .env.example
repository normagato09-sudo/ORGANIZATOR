# ORGANIZATOR — Variables de entorno de servidor (Vercel)
#
# Copia este archivo como referencia de lo que hay que configurar en
# Vercel (Project Settings -> Environment Variables). NUNCA rellenes este
# archivo con valores reales ni lo subas con secretos — solo documenta qué
# variables existen y para qué sirven.

# --- Ya existentes (auth + IA) ---
DATABASE_URL=            # Cadena de conexión de Neon Postgres (lib/db.js)
JWT_SECRET=               # Secreto para firmar la cookie de sesión (lib/session.js)
GROQ_API_KEY=              # Clave de la API de Groq (api/ai.js)

# --- Nuevas para R-8.2-A (Web Push vía QStash) ---

# Origen público HTTPS de esta app, SIN barra final (p.ej.
# https://organizator.vercel.app o tu dominio personalizado). Se usa para
# construir la URL de destino que se le pasa a QStash
# (api/push/schedule-reminder.js) y para reconstruir esa misma URL al
# verificar la firma de la llamada entrante (api/push/send-due.js) — ambas
# deben coincidir EXACTAMENTE o la verificación de firma falla.
PUBLIC_APP_URL=

# Par de claves VAPID (generarlas UNA sola vez con
# `npx web-push generate-vapid-keys`, o `webpush.generateVAPIDKeys()` desde
# un script Node local — nunca desde el propio servidor de producción).
# VAPID_PUBLIC_KEY viaja al navegador (endpoint público
# /api/push/vapid-public-key) — no es un secreto.
# VAPID_PRIVATE_KEY es un secreto real: SOLO en esta variable de entorno de
# servidor. Nunca en organizator.html, nunca en sw.js, nunca en el código
# fuente.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto exigido por la especificación Web Push, formato "mailto:...".
VAPID_SUBJECT=mailto:tu-email@tu-dominio.com

# Token de la API REST de QStash (Upstash Console -> QStash -> tu proyecto).
# Se usa para publicar/cancelar mensajes programados (lib/qstash.js).
QSTASH_TOKEN=

# Claves de firma de QStash (Upstash Console -> QStash -> Signing Keys),
# para verificar que las llamadas a /api/push/send-due vienen de verdad de
# QStash (lib/qstash-receiver.js). QSTASH_NEXT_SIGNING_KEY es la clave que
# entrará en vigor tras la próxima rotación — hace falta configurar AMBAS
# para que la verificación no se rompa justo durante una rotación de
# claves de Upstash.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
