+/* ---------- Resolución determinista de horas para propuestas ----------
+   La IA decide QUÉ proponer y en QUÉ DÍA; la hora exacta la calcula
+   SIEMPRE Scheduler (js/scheduler.js) a partir de los huecos libres
+   reales — nunca se confía en una hora que la IA pueda haber inventado.
+   `workingTasks` es una copia local (no se guarda en state) que va
+   acumulando las propuestas ya colocadas en esta misma pasada, para que
+   dos propuestas del mismo plan nunca se pisen entre sí. */
+function resolveProposalSlot(item, dateStr, workingTasks){
+  if(item.sourceType !== 'proposal') return item; // "existing": se deja tal cual venía del contexto real
+  const duration = (item.estimatedMinutes && item.estimatedMinutes > 0) ? item.estimatedMinutes : 45;
+  item.time = null;
+  if(!window.Scheduler) return item;
+  const ctx = { events: state.events, tasks: workingTasks, customSchedules: state.customSchedules };
+  const slots = window.Scheduler.getFreeSlots(dateStr, ctx);
+  const usable = slots.find(([s,e]) => (e - s) >= duration);
+  if(usable){
+    const start = window.Scheduler._internal.minToTime(usable[0]);
+    const end = window.Scheduler._internal.minToTime(usable[0] + duration);
+    item.time = start;
+    item._durationMinutes = duration;
+    item._endTime = end;
+    workingTasks.push({ id:`ia-tmp-${workingTasks.length}`, scheduledDate:dateStr, scheduledStart:start, scheduledEnd:end });
+  } else {
+    item.noSlot = true;
+    item.reason = (item.reason ? item.reason + ' ' : '') + '(sin hueco libre suficiente ese día — se añadirá sin hora fija)';
+  }
+  return item;
+}
+
+/* ---------- Agenda visual 00:00–23:00 (solo lectura) ----------
+   Se construye a partir de los mismos items ya resueltos (con hora y
+   duración reales); no decide nada, solo dibuja lo que ya se calculó.
+   No sustituye a la lista de propuestas: es un apoyo visual encima de
+   ella. Solo se usa en "Organizar mi día" (un día cabe bien en pantalla;
+   la semana sigue con el formato de lista agrupada por día). */
+function renderDayTimelineGrid(items){
+  const ROW = 44; // px por hora
+  const blocks = items
+    .filter(it => it.time)
+    .map(it => {
+      const [h,m] = it.time.split(':').map(Number);
+      const startMin = h*60 + (m||0);
+      const duration = it.sourceType === 'proposal'
+        ? (it._durationMinutes || it.estimatedMinutes || 45)
+        : (it.durationMinutes && it.durationMinutes > 0 ? it.durationMinutes : 60);
+      return { ...it, startMin, duration };
+    })
+    .sort((a,b) => a.startMin - b.startMin);
+
+  const hoursHtml = Array.from({length:24}, (_,h) => `<div class="ia-hg-hour">${pad(h)}:00</div>`).join('');
+
+  const laneHtml = blocks.map(b => {
+    const top = (b.startMin/60)*ROW;
+    const height = Math.max((b.duration/60)*ROW, 20);
+    const endMin = b.startMin + b.duration;
+    const endClock = `${pad(Math.floor(endMin/60)%24)}:${pad(endMin%60)}`;
+    const isProposal = b.sourceType === 'proposal';
+    const color = b.kind === 'event' ? 'var(--event)' : 'var(--task)';
+    const bg = b.kind === 'event' ? 'var(--event-bg)' : 'var(--task-bg)';
+    const style = isProposal ? `top:${top}px;height:${height}px;border-color:${color};` : `top:${top}px;height:${height}px;background:${bg};border-left-color:${color};`;
+    return `<div class="ia-hg-block${isProposal?' proposal':''}" style="${style}">
+      <span class="ia-hg-title">${esc(b.title)}</span>
+      <span class="ia-hg-time">${esc(b.time)}–${esc(endClock)}</span>
+    </div>`;
+  }).join('');
+
+  const noTimeCount = items.filter(it => !it.time).length;
+
+  return `<div class="ia-hourgrid">
+    <div class="ia-hg-hours">${hoursHtml}</div>
+    <div class="ia-hg-lane" style="height:${24*ROW}px;">${laneHtml}</div>
+  </div>${noTimeCount ? `<p class="ia-hg-note">${noTimeCount} elemento${noTimeCount>1?'s':''} sin hora fija (solo en la lista de abajo).</p>` : ''}`;
+}
